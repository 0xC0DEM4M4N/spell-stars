# Optional. Leave both blank and the site has no account feature.
# Real values go in .env.local (ignored by git), not in this file.
# See supabase/README.md.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Set to true once you have your own email sender (SMTP) set up in Supabase.
# While false, the sign-in page tells people the email comes from Supabase and
# to check their junk folder, and it hides the code box.
REACT_APP_SMTP_CONFIGURED=false

# Practice mode: try the sign-in screens with no setup (no email, no server).
# Never switch this on for the live site.
# REACT_APP_ACCOUNTS_DEMO=true
